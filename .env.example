# Shared sish / Control Plane settings
TUNNEL_DOMAIN=example.com
SSH_HOST=ssh.example.com
VPS_IP=203.0.113.10

SISH_SSH_PORT=2222
SISH_HTTP_PORT=80
SISH_HTTPS_PORT=443

# Vercel DNS read/write is used only by Certbot scripts.
# The Control Plane uses the same token for read-only conflict checks and never mutates records.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/callback

# Direct `go run` development only. Docker Compose reads these values from
# secrets/ files instead of injecting them as environment variables.
# Generate at least 32 random characters (for example: openssl rand -base64 48).
SESSION_SECRET=
ADMIN_DISCORD_IDS=
COOKIE_SECURE=false

# Control Plane
CONTROL_PLANE_ADDR=:8080
CONTROL_PLANE_INTERNAL_ADDR=127.0.0.1:8081
CONTROL_PLANE_INTERNAL_PORT=8081
CONTROL_PLANE_INTERNAL_TOKEN_FILE=../secrets/control-plane-internal-token
CONTROL_PLANE_HOST=
DATABASE_PATH=../data/control-plane.db
PUBKEYS_DIR=../pubkeys

# sish authorization/management (required is the safe default; audit is migration-only).
SISH_CONTROL_PLANE_MODE=required
SISH_CONTROL_PLANE_TIMEOUT=2s
SISH_ABUSE_HTTP_MAX_CONNECTIONS=50
SISH_ABUSE_SSH_MAX_CONNECTIONS=20
SISH_ABUSE_ACCEPT_BURST=60
SISH_ABUSE_REQUEST_BURST=120
SISH_ABUSE_TEMPORARY_BLOCK=5m
SISH_ABUSE_HTTP_READ_HEADER_TIMEOUT=5s
SISH_ABUSE_SSH_HANDSHAKE_TIMEOUT=10s
SISH_MANAGEMENT_URL=http://127.0.0.1:8082
SISH_MANAGEMENT_PORT=8082
SISH_MANAGEMENT_TOKEN_FILE=../secrets/sish-management-token

# Docker bind-mount writer identity (typically the deploying host user).
CONTROL_PLANE_UID=1000
CONTROL_PLANE_GID=1000
