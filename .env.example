# 公開ドメイン
TUNNEL_DOMAIN=fumiya.dev
SSH_HOST=ssh.fumiya.dev
CONTROL_PLANE_HOST=tunnel.fumiya.dev

# Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://tunnel.fumiya.dev/auth/callback
ADMIN_DISCORD_IDS=

# サブドメイン予約時のDNS競合確認とCertbot DNS-01で使用する。
VERCEL_TOKEN=

# 通常はrequiredを使用する。既存鍵の初回移行中だけ一時的にauditへ変更する。
SISH_CONTROL_PLANE_MODE=required

# data、pubkeys、keys、ssl、secretsを所有するVPSユーザーのUID/GID。
CONTROL_PLANE_UID=1000
CONTROL_PLANE_GID=1000
