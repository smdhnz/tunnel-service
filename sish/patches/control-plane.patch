diff --git a/utils/controlplane.go b/utils/controlplane.go
new file mode 100644
index 0000000..a0a26d8
--- /dev/null
+++ b/utils/controlplane.go
@@ -0,0 +1,523 @@
+package utils
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/url"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/spf13/viper"
+)
+
+type ControlPlanePrincipal struct {
+	UserID     int64  `json:"user_id"`
+	KeyID      int64  `json:"key_id"`
+	Generation int64  `json:"generation"`
+	Hostname   string `json:"hostname"`
+}
+type managedTunnel struct {
+	ID          string    `json:"id"`
+	UserID      int64     `json:"user_id"`
+	KeyID       int64     `json:"key_id"`
+	Generation  int64     `json:"generation"`
+	Sequence    int64     `json:"sequence"`
+	Protocol    string    `json:"protocol"`
+	Hostname    string    `json:"hostname"`
+	Port        int       `json:"port"`
+	SourceIP    string    `json:"source_ip"`
+	ConnectedAt time.Time `json:"connected_at"`
+	cleanup     func()
+}
+type tunnelRegistry struct {
+	sync.RWMutex
+	tunnels                 map[string]*managedTunnel
+	keyBarrier, userBarrier map[int64]int64
+	hostBarrier             map[string]int64
+	sequence                int64
+}
+
+var controlSourceID = randomID()
+var controlRegistry = tunnelRegistry{tunnels: map[string]*managedTunnel{}, keyBarrier: map[int64]int64{}, userBarrier: map[int64]int64{}, hostBarrier: map[string]int64{}}
+var securityCounters = struct {
+	sync.Mutex
+	values map[string]int64
+}{values: map[string]int64{}}
+
+func cpMode() string {
+	if strings.EqualFold(viper.GetString("control-plane-mode"), "audit") {
+		return "audit"
+	}
+	return "required"
+}
+func readToken(path string) (string, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return "", err
+	}
+	s := strings.TrimSpace(string(b))
+	if len(s) < 32 {
+		return "", errors.New("token file must contain at least 32 characters")
+	}
+	return s, nil
+}
+func cpRequest(ctx context.Context, method, path string, body, out any) error {
+	base := strings.TrimRight(viper.GetString("control-plane-url"), "/")
+	if base == "" {
+		return errors.New("control-plane-url is empty")
+	}
+	u, err := url.Parse(base)
+	if err != nil || u.Scheme != "http" || !isLoopbackHost(u.Hostname()) {
+		return errors.New("control-plane-url must be HTTP loopback")
+	}
+	var r io.Reader
+	if body != nil {
+		b, e := json.Marshal(body)
+		if e != nil {
+			return e
+		}
+		r = bytes.NewReader(b)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, base+path, r)
+	if err != nil {
+		return err
+	}
+	token, err := readToken(viper.GetString("control-plane-token-file"))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	timeout := viper.GetDuration("control-plane-timeout")
+	if timeout <= 0 {
+		timeout = 2 * time.Second
+	}
+	client := &http.Client{Timeout: timeout}
+	res, err := client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer res.Body.Close()
+	if res.StatusCode < 200 || res.StatusCode >= 300 {
+		return fmt.Errorf("control plane status %d", res.StatusCode)
+	}
+	if out != nil {
+		return json.NewDecoder(io.LimitReader(res.Body, 64<<10)).Decode(out)
+	}
+	return nil
+}
+func isLoopbackHost(host string) bool {
+	ip := net.ParseIP(host)
+	return strings.EqualFold(host, "localhost") || (ip != nil && ip.IsLoopback())
+}
+func remoteIP(addr string) string {
+	h, _, err := net.SplitHostPort(addr)
+	if err == nil {
+		return h
+	}
+	return addr
+}
+func canonicalHostname(host string) string {
+	return strings.ToLower(strings.TrimSuffix(strings.TrimSpace(host), "."))
+}
+func randomID() string {
+	b := make([]byte, 16)
+	if _, err := rand.Read(b); err != nil {
+		panic("random source unavailable")
+	}
+	return hex.EncodeToString(b)
+}
+func nextSequenceLocked() int64 { controlRegistry.sequence++; return controlRegistry.sequence }
+func barredLocked(p ControlPlanePrincipal) bool {
+	return controlRegistry.keyBarrier[p.KeyID] >= p.Generation || controlRegistry.userBarrier[p.UserID] >= p.Generation || (p.Hostname != "" && controlRegistry.hostBarrier[canonicalHostname(p.Hostname)] >= p.Generation)
+}
+
+func ControlPlaneAuthorize(conn *SSHConnection, protocol, hostname string, port uint32) (ControlPlanePrincipal, error) {
+	fp := ""
+	if conn.SSHConn.Permissions != nil {
+		fp = conn.SSHConn.Permissions.Extensions["pubKeyFingerprint"]
+	}
+	q := map[string]any{"fingerprint": fp, "ssh_user": conn.SSHConn.User(), "protocol": protocol, "hostname": hostname, "port": port, "source_ip": remoteIP(conn.SSHConn.RemoteAddr().String())}
+	var p ControlPlanePrincipal
+	err := cpRequest(context.Background(), http.MethodPost, "/v1/authorize", q, &p)
+	if err == nil && ((p.UserID > 0 && p.KeyID > 0) || (p.UserID == 0 && p.KeyID < 0)) && p.Generation > 0 {
+		p.Hostname = canonicalHostname(p.Hostname)
+		controlRegistry.RLock()
+		blocked := barredLocked(p)
+		controlRegistry.RUnlock()
+		if !blocked {
+			return p, nil
+		}
+		err = errors.New("authorization generation is quiesced")
+	}
+	countSecurity("authorization_denied", 1)
+	if err != nil {
+		return p, err
+	}
+	return p, errors.New("authorization response missing principal")
+}
+
+// ControlPlaneRegister holds the registry lifecycle boundary while the durable
+// connect callback is acknowledged. Management quiesce cannot interleave; a
+// barrier retained by a zero-match disconnect rejects any late generation.
+func ControlPlaneRegister(conn *SSHConnection, p ControlPlanePrincipal, protocol string, port uint32, cleanup func()) (string, error) {
+	id := randomID()
+	controlRegistry.Lock()
+	defer controlRegistry.Unlock()
+	if barredLocked(p) {
+		return "", errors.New("authorization generation quiesced")
+	}
+	seq := nextSequenceLocked()
+	t := &managedTunnel{ID: id, UserID: p.UserID, KeyID: p.KeyID, Generation: p.Generation, Sequence: seq, Protocol: protocol, Hostname: p.Hostname, Port: int(port), SourceIP: remoteIP(conn.SSHConn.RemoteAddr().String()), ConnectedAt: time.Now().UTC()}
+	t.cleanup = func() { cleanup(); ControlPlaneUnregister(id) }
+	body := map[string]any{"event_id": randomID(), "source_id": controlSourceID, "id": t.ID, "user_id": t.UserID, "key_id": t.KeyID, "generation": t.Generation, "sequence": seq, "protocol": t.Protocol, "hostname": t.Hostname, "port": t.Port, "source_ip": t.SourceIP, "connected_at": t.ConnectedAt}
+	if err := cpRequest(context.Background(), http.MethodPost, "/v1/tunnels/connect", body, nil); err != nil {
+		return "", err
+	}
+	controlRegistry.tunnels[id] = t
+	return id, nil
+}
+func ControlPlaneUnregister(id string) {
+	if id == "" {
+		return
+	}
+	controlRegistry.Lock()
+	t, ok := controlRegistry.tunnels[id]
+	if ok {
+		delete(controlRegistry.tunnels, id)
+	}
+	seq := nextSequenceLocked()
+	controlRegistry.Unlock()
+	if !ok {
+		return
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	body := map[string]any{"event_id": randomID(), "source_id": controlSourceID, "sequence": seq, "disconnected_at": time.Now().UTC()}
+	if err := cpRequest(ctx, http.MethodPost, "/v1/tunnels/"+url.PathEscape(id)+"/disconnect", body, nil); err != nil {
+		log.Printf("control plane tunnel disconnect event failed: %v", err)
+	}
+	_ = t
+}
+func ControlPlaneHostActive(host string) bool {
+	host = canonicalHostname(host)
+	controlRegistry.RLock()
+	defer controlRegistry.RUnlock()
+	for _, t := range controlRegistry.tunnels {
+		if t.Hostname == host {
+			return true
+		}
+	}
+	return false
+}
+func ControlPlaneEnabled() bool  { return viper.GetString("control-plane-url") != "" }
+func ControlPlaneRequired() bool { return cpMode() == "required" }
+
+func StartControlPlaneManagement(state *State) {
+	if !ControlPlaneEnabled() {
+		if cpMode() == "required" {
+			log.Fatal("control-plane-url is required in required mode")
+		}
+		return
+	}
+	addr := viper.GetString("control-plane-management-address")
+	if addr == "" {
+		addr = "127.0.0.1:8082"
+	}
+	h, _, err := net.SplitHostPort(addr)
+	if err != nil || !isLoopbackHost(h) {
+		log.Fatal("control-plane-management-address must be loopback-only")
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /v1/tunnels", managementAuth(func(w http.ResponseWriter, r *http.Request) {
+		controlRegistry.RLock()
+		out := make([]*managedTunnel, 0, len(controlRegistry.tunnels))
+		for _, t := range controlRegistry.tunnels {
+			out = append(out, t)
+		}
+		seq := controlRegistry.sequence
+		controlRegistry.RUnlock()
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(map[string]any{"source_id": controlSourceID, "sequence": seq, "tunnels": out})
+	}))
+	mux.HandleFunc("POST /v1/disconnect", managementAuth(disconnectManaged))
+	mux.HandleFunc("GET /v1/metrics", managementAuth(func(w http.ResponseWriter, r *http.Request) {
+		securityCounters.Lock()
+		m := map[string]int64{}
+		for k, v := range securityCounters.values {
+			m[k] = v
+		}
+		securityCounters.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		_ = json.NewEncoder(w).Encode(m)
+	}))
+	srv := &http.Server{Addr: addr, Handler: mux, ReadHeaderTimeout: 2 * time.Second, ReadTimeout: 5 * time.Second, WriteTimeout: 5 * time.Second, IdleTimeout: 15 * time.Second, MaxHeaderBytes: 16 << 10}
+	go func() {
+		if err := srv.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+			log.Fatalf("control plane management server: %v", err)
+		}
+	}()
+	go telemetryLoop()
+	_ = state
+}
+func disconnectManaged(w http.ResponseWriter, r *http.Request) {
+	r.Body = http.MaxBytesReader(w, r.Body, 16<<10)
+	var q struct {
+		KeyID      int64  `json:"key_id"`
+		UserID     int64  `json:"user_id"`
+		Generation int64  `json:"generation"`
+		Hostname   string `json:"hostname"`
+		TunnelID   string `json:"tunnel_id"`
+	}
+	d := json.NewDecoder(r.Body)
+	d.DisallowUnknownFields()
+	if d.Decode(&q) != nil || q.Generation < 1 {
+		http.Error(w, "bad request", 400)
+		return
+	}
+	q.Hostname = canonicalHostname(q.Hostname)
+	controlRegistry.Lock()
+	if q.KeyID > 0 && q.Generation > controlRegistry.keyBarrier[q.KeyID] {
+		controlRegistry.keyBarrier[q.KeyID] = q.Generation
+	}
+	if q.UserID > 0 && q.Generation > controlRegistry.userBarrier[q.UserID] {
+		controlRegistry.userBarrier[q.UserID] = q.Generation
+	}
+	if q.Hostname != "" && q.Generation > controlRegistry.hostBarrier[q.Hostname] {
+		controlRegistry.hostBarrier[q.Hostname] = q.Generation
+	}
+	cleanups := []func(){}
+	for _, t := range controlRegistry.tunnels {
+		if (q.TunnelID != "" && t.ID == q.TunnelID) || (q.KeyID > 0 && t.KeyID == q.KeyID) || (q.UserID > 0 && t.UserID == q.UserID) || (q.Hostname != "" && t.Hostname == q.Hostname) {
+			cleanups = append(cleanups, t.cleanup)
+		}
+	}
+	controlRegistry.Unlock()
+	for _, cleanup := range cleanups {
+		if cleanup != nil {
+			cleanup()
+		}
+	}
+	w.WriteHeader(204)
+}
+func managementAuth(next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		h, _, err := net.SplitHostPort(r.RemoteAddr)
+		if err != nil || !isLoopbackHost(h) {
+			http.Error(w, "forbidden", 403)
+			return
+		}
+		token, err := readToken(viper.GetString("control-plane-management-token-file"))
+		got := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+		if err != nil || len(got) != len(token) || subtle.ConstantTimeCompare([]byte(got), []byte(token)) != 1 {
+			http.Error(w, "unauthorized", 401)
+			return
+		}
+		next(w, r)
+	}
+}
+func countSecurity(k string, n int64) {
+	securityCounters.Lock()
+	securityCounters.values[k] += n
+	securityCounters.Unlock()
+}
+func CountUnknownHost() { countSecurity("unknown_host", 1) }
+func telemetryLoop() {
+	ticker := time.NewTicker(time.Minute)
+	defer ticker.Stop()
+	var pending map[string]any
+	for range ticker.C {
+		if pending == nil {
+			securityCounters.Lock()
+			m := map[string]int64{}
+			for k, v := range securityCounters.values {
+				if v > 0 {
+					m[k] = v
+					securityCounters.values[k] = 0
+				}
+			}
+			securityCounters.Unlock()
+			if len(m) == 0 {
+				continue
+			}
+			pending = map[string]any{"event_id": randomID(), "events": m}
+		}
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		err := cpRequest(ctx, http.MethodPost, "/v1/telemetry", pending, nil)
+		cancel()
+		if err == nil {
+			pending = nil
+		}
+	}
+}
+
+// AcceptLimiter is applied to public listeners before protocol parsing. It
+// bounds slowloris sockets as connections, not merely in-flight HTTP handlers.
+type abuseEntry struct {
+	tokens                  float64
+	updated, blocked        time.Time
+	connections, violations int
+}
+
+var abuseState = struct {
+	sync.Mutex
+	m map[string]*abuseEntry
+}{m: map[string]*abuseEntry{}}
+
+type limitedConn struct {
+	net.Conn
+	once    sync.Once
+	release func()
+}
+
+func (c *limitedConn) Close() error { c.once.Do(c.release); return c.Conn.Close() }
+
+type AbuseListener struct {
+	net.Listener
+	Kind string
+}
+
+func NewAbuseListener(l net.Listener, kind string) net.Listener {
+	return &AbuseListener{Listener: l, Kind: kind}
+}
+func (l *AbuseListener) Accept() (net.Conn, error) {
+	for {
+		c, err := l.Listener.Accept()
+		if err != nil {
+			return nil, err
+		}
+		release, ok := allowConnection(c.RemoteAddr().String(), l.Kind)
+		if !ok {
+			_ = c.Close()
+			continue
+		}
+		return &limitedConn{Conn: c, release: release}, nil
+	}
+}
+func allowConnection(addr, kind string) (func(), bool) {
+	ip := remoteIP(addr)
+	now := time.Now()
+	abuseState.Lock()
+	defer abuseState.Unlock()
+	e := abuseState.m[ip]
+	if e == nil {
+		if len(abuseState.m) >= 10000 {
+			for k, v := range abuseState.m {
+				if now.Sub(v.updated) > 10*time.Minute && v.connections == 0 {
+					delete(abuseState.m, k)
+				}
+			}
+		}
+		if len(abuseState.m) >= 10000 {
+			countSecurity("connection_limited", 1)
+			return func() {}, false
+		}
+		e = &abuseEntry{tokens: float64(max(1, viper.GetInt("abuse-accept-burst"))), updated: now}
+		abuseState.m[ip] = e
+	}
+	if now.Before(e.blocked) {
+		countSecurity("temporarily_blocked", 1)
+		return func() {}, false
+	}
+	e.tokens = min(float64(max(1, viper.GetInt("abuse-accept-burst"))), e.tokens+now.Sub(e.updated).Seconds())
+	e.updated = now
+	maxConn := max(1, viper.GetInt("abuse-http-max-connections"))
+	if kind == "ssh" {
+		maxConn = max(1, viper.GetInt("abuse-ssh-max-connections"))
+	}
+	if e.tokens < 1 || e.connections >= maxConn {
+		e.violations++
+		countSecurity("connection_limited", 1)
+		if e.violations >= 5 {
+			block := viper.GetDuration("abuse-temporary-block")
+			if block <= 0 {
+				block = 5 * time.Minute
+			}
+			e.blocked = now.Add(block)
+			e.violations = 0
+		}
+		return func() {}, false
+	}
+	e.tokens--
+	e.connections++
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			abuseState.Lock()
+			if e.connections > 0 {
+				e.connections--
+			}
+			abuseState.Unlock()
+		})
+	}, true
+}
+
+// RequestAllow provides a separate request-rate bucket; connection accounting
+// is exclusively performed by AbuseListener.
+func AbuseAllow(addr, host string) (func(), bool) {
+	ip := remoteIP(addr)
+	host = strings.ToLower(strings.TrimSuffix(strings.TrimSpace(host), "."))
+	if h, _, err := net.SplitHostPort(host); err == nil {
+		host = h
+	}
+	key := "request:" + ip + ":" + host
+	now := time.Now()
+	abuseState.Lock()
+	e := abuseState.m[key]
+	if e == nil {
+		e = &abuseEntry{tokens: float64(max(1, viper.GetInt("abuse-request-burst"))), updated: now}
+		abuseState.m[key] = e
+	}
+	if now.Before(e.blocked) {
+		abuseState.Unlock()
+		countSecurity("temporarily_blocked", 1)
+		return func() {}, false
+	}
+	e.tokens = min(float64(max(1, viper.GetInt("abuse-request-burst"))), e.tokens+now.Sub(e.updated).Seconds()*float64(max(1, viper.GetInt("abuse-request-rate"))))
+	e.updated = now
+	if e.tokens < 1 {
+		e.violations++
+		if e.violations >= 10 {
+			block := viper.GetDuration("abuse-temporary-block")
+			if block <= 0 {
+				block = 5 * time.Minute
+			}
+			e.blocked = now.Add(block)
+			e.violations = 0
+		}
+		abuseState.Unlock()
+		countSecurity("rate_limited", 1)
+		return func() {}, false
+	}
+	e.tokens--
+	abuseState.Unlock()
+	return func() {}, true
+}
+func ParseProtocol(listenerType ListenerType, port, HTTPPort, HTTPSPort uint32, sni bool) string {
+	if listenerType == HTTPListener {
+		if port == HTTPSPort {
+			return "https"
+		}
+		return "http"
+	}
+	if sni {
+		return "tls"
+	}
+	return "tcp"
+}
+func ParseUintPort(v uint32) string { return strconv.FormatUint(uint64(v), 10) }
