+package utils
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/spf13/viper"
+)
+
+func setupControlPlaneTest(t *testing.T, handler http.Handler) string {
+	t.Helper()
+	srv := httptest.NewServer(handler)
+	t.Cleanup(srv.Close)
+	token := filepath.Join(t.TempDir(), "token")
+	if err := os.WriteFile(token, []byte("01234567890123456789012345678901\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	viper.Set("control-plane-url", srv.URL)
+	viper.Set("control-plane-token-file", token)
+	viper.Set("control-plane-timeout", 100*time.Millisecond)
+	t.Cleanup(func() { viper.Reset() })
+	return token
+}
+func TestControlPlaneMode(t *testing.T) {
+	viper.Set("control-plane-mode", "audit")
+	if cpMode() != "audit" {
+		t.Fatal("audit mode changed")
+	}
+	viper.Set("control-plane-mode", "required")
+	if cpMode() != "required" {
+		t.Fatal("required mode changed")
+	}
+	viper.Set("control-plane-mode", "unknown")
+	if cpMode() != "required" {
+		t.Fatal("unknown mode did not fail closed")
+	}
+}
+func TestControlPlaneRequestFailClosedOnStatusAndTimeout(t *testing.T) {
+	setupControlPlaneTest(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { http.Error(w, "no", http.StatusForbidden) }))
+	if err := cpRequest(t.Context(), http.MethodPost, "/v1/authorize", map[string]string{"x": "y"}, nil); err == nil {
+		t.Fatal("non-2xx accepted")
+	}
+	viper.Reset()
+	setupControlPlaneTest(t, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { time.Sleep(250 * time.Millisecond) }))
+	if err := cpRequest(t.Context(), http.MethodPost, "/v1/authorize", nil, nil); err == nil {
+		t.Fatal("timeout accepted")
+	}
+}
+func TestAbuseLimiterBlocksBurstAndBoundsState(t *testing.T) {
+	viper.Set("abuse-request-burst", 120)
+	t.Cleanup(viper.Reset)
+	abuseState.Lock()
+	abuseState.m = map[string]*abuseEntry{}
+	abuseState.Unlock()
+	allowed := 0
+	for i := 0; i < 100; i++ {
+		release, ok := AbuseAllow("192.0.2.1:1234", "app.example.test")
+		if ok {
+			allowed++
+			release()
+		}
+	}
+	if allowed != 100 {
+		t.Fatalf("burst allowed=%d", allowed)
+	}
+	for i := 0; i < 120; i++ {
+		_, _ = AbuseAllow("192.0.2.1:1234", "other.example.test")
+	}
+	abuseState.Lock()
+	n := len(abuseState.m)
+	abuseState.Unlock()
+	if n != 2 {
+		t.Fatalf("host buckets not isolated: entries=%d", n)
+	}
+}
