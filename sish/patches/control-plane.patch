+
+func resetControlRegistry() {
+	controlRegistry.Lock()
+	defer controlRegistry.Unlock()
+	controlRegistry.tunnels = map[string]*managedTunnel{}
+	controlRegistry.keyBarrier = map[int64]int64{}
+	controlRegistry.userBarrier = map[int64]int64{}
+	controlRegistry.hostBarrier = map[string]int64{}
+	controlRegistry.sequence = 0
+}
+func TestDisconnectBarrierRejectsLateAuthorizedGeneration(t *testing.T) {
+	resetControlRegistry()
+	body := bytes.NewBufferString(`{"key_id":7,"generation":12}`)
+	r := httptest.NewRequest("POST", "/v1/disconnect", body)
+	w := httptest.NewRecorder()
+	disconnectManaged(w, r)
+	if w.Code != 204 {
+		t.Fatalf("status=%d", w.Code)
+	}
+	controlRegistry.RLock()
+	blocked := barredLocked(ControlPlanePrincipal{UserID: 3, KeyID: 7, Generation: 11})
+	newer := barredLocked(ControlPlanePrincipal{UserID: 3, KeyID: 7, Generation: 13})
+	controlRegistry.RUnlock()
+	if !blocked || newer {
+		t.Fatalf("blocked=%v newer=%v", blocked, newer)
+	}
+}
+func TestDisconnectHostnameOnlyCleansMatchingTunnel(t *testing.T) {
+	resetControlRegistry()
+	var a, b atomic.Int32
+	controlRegistry.Lock()
+	controlRegistry.tunnels["a"] = &managedTunnel{ID: "a", Hostname: "a.example.com", Generation: 1, cleanup: func() { a.Add(1) }}
+	controlRegistry.tunnels["b"] = &managedTunnel{ID: "b", Hostname: "b.example.com", Generation: 1, cleanup: func() { b.Add(1) }}
+	controlRegistry.Unlock()
+	r := httptest.NewRequest("POST", "/v1/disconnect", bytes.NewBufferString(`{"hostname":"a.example.com","generation":2}`))
+	w := httptest.NewRecorder()
+	disconnectManaged(w, r)
+	if a.Load() != 1 || b.Load() != 0 {
+		t.Fatalf("cleanup a=%d b=%d", a.Load(), b.Load())
+	}
+}
+func TestDisconnectAndLateRegistrationBarrierRace(t *testing.T) {
+	for i := 0; i < 100; i++ {
+		resetControlRegistry()
+		p := ControlPlanePrincipal{UserID: 1, KeyID: 2, Generation: 4, Hostname: "x.example.com"}
+		start := make(chan struct{})
+		var wg sync.WaitGroup
+		wg.Add(2)
+		var accepted atomic.Bool
+		go func() {
+			defer wg.Done()
+			<-start
+			controlRegistry.Lock()
+			if !barredLocked(p) {
+				accepted.Store(true)
+				controlRegistry.tunnels["late"] = &managedTunnel{ID: "late", UserID: 1, KeyID: 2, Generation: 4, Hostname: p.Hostname, cleanup: func() { controlRegistry.Lock(); delete(controlRegistry.tunnels, "late"); controlRegistry.Unlock() }}
+			}
+			controlRegistry.Unlock()
+		}()
+		go func() {
+			defer wg.Done()
+			<-start
+			r := httptest.NewRequest("POST", "/v1/disconnect", bytes.NewBufferString(`{"key_id":2,"generation":5}`))
+			disconnectManaged(httptest.NewRecorder(), r)
+		}()
+		close(start)
+		wg.Wait()
+		controlRegistry.RLock()
+		_, left := controlRegistry.tunnels["late"]
+		barrier := controlRegistry.keyBarrier[2]
+		controlRegistry.RUnlock()
+		if left && barrier == 5 {
+			t.Fatalf("late tunnel survived quiesce (accepted=%v)", accepted.Load())
+		}
+	}
+}
+
+type testListener struct {
+	ch   chan net.Conn
+	once sync.Once
+}
+
+func (l *testListener) Accept() (net.Conn, error) {
+	c, ok := <-l.ch
+	if !ok {
+		return nil, net.ErrClosed
+	}
+	return c, nil
+}
+func (l *testListener) Close() error   { l.once.Do(func() { close(l.ch) }); return nil }
+func (l *testListener) Addr() net.Addr { return &net.TCPAddr{IP: net.ParseIP("127.0.0.1"), Port: 80} }
+func TestAbuseListenerCountsUntilConnectionClose(t *testing.T) {
+	viper.Set("abuse-accept-burst", 60)
+	viper.Set("abuse-ssh-max-connections", 20)
+	t.Cleanup(viper.Reset)
+	abuseState.Lock()
+	abuseState.m = map[string]*abuseEntry{}
+	abuseState.Unlock()
+	server, client := net.Pipe()
+	defer client.Close()
+	l := &testListener{ch: make(chan net.Conn, 1)}
+	l.ch <- &addrConn{Conn: server, remote: &net.TCPAddr{IP: net.ParseIP("192.0.2.9"), Port: 1}}
+	wrapped := NewAbuseListener(l, "ssh")
+	c, err := wrapped.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	abuseState.Lock()
+	n := abuseState.m["192.0.2.9"].connections
+	abuseState.Unlock()
+	if n != 1 {
+		t.Fatalf("connections=%d", n)
+	}
+	_ = c.Close()
+	time.Sleep(time.Millisecond)
+	abuseState.Lock()
+	n = abuseState.m["192.0.2.9"].connections
+	abuseState.Unlock()
+	if n != 0 {
+		t.Fatalf("connections after close=%d", n)
+	}
+}
+
+type addrConn struct {
+	net.Conn
+	remote net.Addr
+}
+
+func (c *addrConn) RemoteAddr() net.Addr { return c.remote }
